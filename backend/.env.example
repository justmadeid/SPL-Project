# Koneksi Neo4j (Neo4j Desktop: buat/jalankan instance, lalu isi password-nya di sini)
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ganti-dengan-password-anda
NEO4J_DATABASE=neo4j

# Gemini (opsional). Ambil API key di https://aistudio.google.com/apikey
# Tanpa key, sistem pakar tetap jalan; fitur AI (isi otomatis, penjelasan, asisten) nonaktif.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Model cadangan bila model utama sibuk (dipisah koma)
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.5-flash
