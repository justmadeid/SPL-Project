<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
  xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
>
  <rdf:Property rdf:about="http://pintukuliah.local/ontologi#jenis_kelas">
    <rdfs:domain rdf:resource="http://pintukuliah.local/ontologi#Pendaftar"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Property>
  <rdf:Property rdf:about="http://pintukuliah.local/ontologi#MEMICU">
    <rdfs:domain rdf:resource="http://pintukuliah.local/ontologi#Pendaftar"/>
    <rdfs:range rdf:resource="http://pintukuliah.local/ontologi#Rule"/>
    <rdfs:comment>Jejak penjelasan: aturan yang menyala untuk pendaftar ini. Di Neo4j relasi ini membawa properti urutan dan kesimpulan (padanannya di RDF: reifikasi atau RDF-star).</rdfs:comment>
  </rdf:Property>
  <rdf:Property rdf:about="http://pintukuliah.local/ontologi#nama_prodi">
    <rdfs:domain rdf:resource="http://pintukuliah.local/ontologi#Pendaftar"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Property>
  <rdf:Property rdf:about="http://pintukuliah.local/ontologi#nama_kampus">
    <rdfs:domain rdf:resource="http://pintukuliah.local/ontologi#Pendaftar"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Property>
  <rdf:Property rdf:about="http://pintukuliah.local/ontologi#WAJIB_MENYERAHKAN">
    <rdfs:domain rdf:resource="http://pintukuliah.local/ontologi#Pendaftar"/>
    <rdfs:range rdf:resource="http://pintukuliah.local/ontologi#Dokumen"/>
    <rdfs:comment>Dokumen yang wajib diserahkan (F-00 s.d. F-09)</rdfs:comment>
  </rdf:Property>
  <rdf:Property rdf:about="http://pintukuliah.local/ontologi#terdata_p3ke">
    <rdfs:domain rdf:resource="http://pintukuliah.local/ontologi#Pendaftar"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Property>
  <rdf:Property rdf:about="http://pintukuliah.local/ontologi#jalur">
    <rdfs:domain rdf:resource="http://pintukuliah.local/ontologi#Pendaftar"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Lapis E</rdfs:comment>
  </rdf:Property>
  <rdf:Property rdf:about="http://pintukuliah.local/ontologi#urut">
    <rdfs:domain rdf:resource="http://pintukuliah.local/ontologi#Rule"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Property>
  <rdf:Property rdf:about="http://pintukuliah.local/ontologi#MEMBUTUHKAN">
    <rdfs:range rdf:resource="http://pintukuliah.local/ontologi#Dokumen"/>
    <rdfs:comment>Dokumen bukti untuk sebuah kategori ekonomi atau kondisi khusus. Domainnya gabungan KategoriEkonomi dan KondisiKhusus; RDFS tidak punya union, jadi rdfs:domain tidak ditulis (dua rdfs:domain berarti irisan).</rdfs:comment>
  </rdf:Property>
  <rdf:Property rdf:about="http://pintukuliah.local/ontologi#GUGUR_KARENA">
    <rdfs:domain rdf:resource="http://pintukuliah.local/ontologi#Pendaftar"/>
    <rdfs:range rdf:resource="http://pintukuliah.local/ontologi#AlasanGugur"/>
    <rdfs:comment>Alasan gugur administrasi (B-02 s.d. B-07)</rdfs:comment>
  </rdf:Property>
  <rdf:Property rdf:about="http://pintukuliah.local/ontologi#status_seleksi">
    <rdfs:domain rdf:resource="http://pintukuliah.local/ontologi#Pendaftar"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Lulus | Tidak_Lulus</rdfs:comment>
  </rdf:Property>
  <rdf:Property rdf:about="http://pintukuliah.local/ontologi#teks">
    <rdfs:domain rdf:resource="http://pintukuliah.local/ontologi#AlasanGugur"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Property>
  <rdf:Property rdf:about="http://pintukuliah.local/ontologi#maks">
    <rdfs:domain rdf:resource="http://pintukuliah.local/ontologi#BiayaPendidikan"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:comment>Batas biaya per semester (rupiah)</rdfs:comment>
  </rdf:Property>
  <rdf:Property rdf:about="http://pintukuliah.local/ontologi#kategori_nama">
    <rdfs:domain rdf:resource="http://pintukuliah.local/ontologi#Pendaftar"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Lapis C</rdfs:comment>
  </rdf:Property>
  <rdf:Property rdf:about="http://pintukuliah.local/ontologi#bencana">
    <rdfs:domain rdf:resource="http://pintukuliah.local/ontologi#Pendaftar"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Property>
  <rdf:Property rdf:about="http://pintukuliah.local/ontologi#rumpun_prodi">
    <rdfs:domain rdf:resource="http://pintukuliah.local/ontologi#Pendaftar"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Property>
  <rdf:Property rdf:about="http://pintukuliah.local/ontologi#jenis_kampus">
    <rdfs:domain rdf:resource="http://pintukuliah.local/ontologi#Pendaftar"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>PTN | PTS</rdfs:comment>
  </rdf:Property>
  <rdf:Property rdf:about="http://pintukuliah.local/ontologi#MEMILIKI_KONDISI">
    <rdfs:domain rdf:resource="http://pintukuliah.local/ontologi#Pendaftar"/>
    <rdfs:range rdf:resource="http://pintukuliah.local/ontologi#KondisiKhusus"/>
    <rdfs:comment>Kondisi afirmasi yang dimiliki pendaftar (D-01)</rdfs:comment>
  </rdf:Property>
  <rdf:Property rdf:about="http://pintukuliah.local/ontologi#lapis">
    <rdfs:domain rdf:resource="http://pintukuliah.local/ontologi#Rule"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Lapis A-G</rdfs:comment>
  </rdf:Property>
  <rdf:Property rdf:about="http://pintukuliah.local/ontologi#bagian">
    <rdfs:domain rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Statement"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Halaman/pasal regulasi yang dirujuk (BERDASARKAN)</rdfs:comment>
  </rdf:Property>
  <rdf:Property rdf:about="http://pintukuliah.local/ontologi#miskin_penghasilan">
    <rdfs:domain rdf:resource="http://pintukuliah.local/ontologi#Pendaftar"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:comment>Lapis A</rdfs:comment>
  </rdf:Property>
  <rdf:Property rdf:about="http://pintukuliah.local/ontologi#kondisi_khusus">
    <rdfs:domain rdf:resource="http://pintukuliah.local/ontologi#Pendaftar"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:comment>Lapis D</rdfs:comment>
  </rdf:Property>
  <rdf:Property rdf:about="http://pintukuliah.local/ontologi#strata">
    <rdfs:domain rdf:resource="http://pintukuliah.local/ontologi#Rule"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:comment>Strata forward chaining (negasi dan agregat)</rdfs:comment>
  </rdf:Property>
  <rdf:Property rdf:about="http://pintukuliah.local/ontologi#BERKATEGORI">
    <rdfs:subPropertyOf>
      <rdf:Property rdf:about="http://pintukuliah.local/ontologi#COCOK_PRIORITAS">
        <rdfs:domain rdf:resource="http://pintukuliah.local/ontologi#Pendaftar"/>
        <rdfs:range rdf:resource="http://pintukuliah.local/ontologi#KategoriEkonomi"/>
        <rdfs:comment>Kategori ekonomi yang syaratnya dipenuhi pendaftar (C-01 s.d. C-08)</rdfs:comment>
      </rdf:Property>
    </rdfs:subPropertyOf>
    <rdfs:domain rdf:resource="http://pintukuliah.local/ontologi#Pendaftar"/>
    <rdfs:range rdf:resource="http://pintukuliah.local/ontologi#KategoriEkonomi"/>
    <rdfs:comment>Kategori final = prioritas terkecil (MIN) di antara yang cocok (C-09)</rdfs:comment>
  </rdf:Property>
  <rdf:Property rdf:about="http://pintukuliah.local/ontologi#id">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Identitas Rule (A-01, ...) dan Pendaftar (UUID)</rdfs:comment>
  </rdf:Property>
  <rdf:Property rdf:about="http://pintukuliah.local/ontologi#KULIAH_DI">
    <rdfs:domain rdf:resource="http://pintukuliah.local/ontologi#Pendaftar"/>
    <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdfs:comment>Jenis kampus tujuan. Kampus tidak dimodelkan sebagai individu, jadi objeknya adalah kelas kip:PTN atau kip:PTS (subkelas kip:PerguruanTinggi), sama seperti di Neo4j yang menunjuk node :Kelas.</rdfs:comment>
  </rdf:Property>
  <rdf:Property rdf:about="http://pintukuliah.local/ontologi#DIPUTUSKAN">
    <rdfs:domain rdf:resource="http://pintukuliah.local/ontologi#Pendaftar"/>
    <rdfs:range rdf:resource="http://pintukuliah.local/ontologi#Keputusan"/>
    <rdfs:comment>Keputusan akhir kelayakan (E-01 s.d. E-04)</rdfs:comment>
  </rdf:Property>
  <rdf:Property rdf:about="http://pintukuliah.local/ontologi#tingkat">
    <rdfs:domain rdf:resource="http://pintukuliah.local/ontologi#BiayaPendidikan"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Property>
  <rdf:Property rdf:about="http://pintukuliah.local/ontologi#zona">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Klaster biaya hidup; dipakai pada ZonaBiayaHidup dan Pendaftar</rdfs:comment>
  </rdf:Property>
  <rdf:Property rdf:about="http://pintukuliah.local/ontologi#penghasilan">
    <rdfs:domain rdf:resource="http://pintukuliah.local/ontologi#Pendaftar"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:comment>Penghasilan gabungan orang tua per bulan (rupiah)</rdfs:comment>
  </rdf:Property>
  <rdf:Property rdf:about="http://pintukuliah.local/ontologi#maka">
    <rdfs:domain rdf:resource="http://pintukuliah.local/ontologi#Rule"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Property>
  <rdf:Property rdf:about="http://pintukuliah.local/ontologi#dibuat">
    <rdfs:domain rdf:resource="http://pintukuliah.local/ontologi#Pendaftar"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:comment>Waktu evaluasi; di Neo4j disimpan sebagai string ISO</rdfs:comment>
  </rdf:Property>
  <rdf:Property rdf:about="http://pintukuliah.local/ontologi#desil_p3ke">
    <rdfs:domain rdf:resource="http://pintukuliah.local/ontologi#Pendaftar"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Property>
  <rdf:Property rdf:about="http://pintukuliah.local/ontologi#penerima_bansos">
    <rdfs:domain rdf:resource="http://pintukuliah.local/ontologi#Pendaftar"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:comment>Lapis A</rdfs:comment>
  </rdf:Property>
  <rdf:Property rdf:about="http://pintukuliah.local/ontologi#kategori_ekonomi">
    <rdfs:domain rdf:resource="http://pintukuliah.local/ontologi#Pendaftar"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Lapis C; salinan kode dari kip:BERKATEGORI</rdfs:comment>
  </rdf:Property>
  <rdf:Property rdf:about="http://pintukuliah.local/ontologi#rumpun">
    <rdfs:domain rdf:resource="http://pintukuliah.local/ontologi#ProgramProfesi"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Property>
  <rdf:Property rdf:about="http://pintukuliah.local/ontologi#sktm">
    <rdfs:domain rdf:resource="http://pintukuliah.local/ontologi#Pendaftar"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Property>
  <rdf:Property rdf:about="http://pintukuliah.local/ontologi#anak_tki">
    <rdfs:domain rdf:resource="http://pintukuliah.local/ontologi#Pendaftar"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Property>
  <rdf:Property rdf:about="http://pintukuliah.local/ontologi#konflik">
    <rdfs:domain rdf:resource="http://pintukuliah.local/ontologi#Pendaftar"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Property>
  <rdf:Property rdf:about="http://pintukuliah.local/ontologi#anggota_keluarga">
    <rdfs:domain rdf:resource="http://pintukuliah.local/ontologi#Pendaftar"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Property>
  <rdf:Property rdf:about="http://pintukuliah.local/ontologi#korban_ham">
    <rdfs:domain rdf:resource="http://pintukuliah.local/ontologi#Pendaftar"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Property>
  <rdfs:Class rdf:about="http://pintukuliah.local/ontologi#PendaftarTidakLayak">
    <rdfs:subClassOf rdf:resource="http://pintukuliah.local/ontologi#Pendaftar"/>
    <rdfs:comment>Pendaftar yang disimpulkan tidak layak</rdfs:comment>
  </rdfs:Class>
  <rdf:Property rdf:about="http://pintukuliah.local/ontologi#lapis_nama">
    <rdfs:domain rdf:resource="http://pintukuliah.local/ontologi#Rule"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Property>
  <rdf:Property rdf:about="http://pintukuliah.local/ontologi#panti">
    <rdfs:domain rdf:resource="http://pintukuliah.local/ontologi#Pendaftar"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Property>
  <rdf:Property rdf:about="http://pintukuliah.local/ontologi#tahun_lulus">
    <rdfs:domain rdf:resource="http://pintukuliah.local/ontologi#Pendaftar"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Property>
  <rdf:Property rdf:about="http://pintukuliah.local/ontologi#asli_papua">
    <rdfs:domain rdf:resource="http://pintukuliah.local/ontologi#Pendaftar"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Property>
  <rdf:Property rdf:about="http://pintukuliah.local/ontologi#beasiswa_lain">
    <rdfs:domain rdf:resource="http://pintukuliah.local/ontologi#Pendaftar"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Property>
  <rdf:Property rdf:about="http://pintukuliah.local/ontologi#properti">
    <rdfs:domain rdf:resource="http://pintukuliah.local/ontologi#KondisiKhusus"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Nama properti boolean Pendaftar yang menandai kondisi ini</rdfs:comment>
  </rdf:Property>
  <rdfs:Class rdf:about="http://pintukuliah.local/ontologi#PTN">
    <rdfs:subClassOf rdf:resource="http://pintukuliah.local/ontologi#PerguruanTinggi"/>
    <rdfs:comment>Perguruan Tinggi Negeri</rdfs:comment>
  </rdfs:Class>
  <rdf:Property rdf:about="http://pintukuliah.local/ontologi#prioritas">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:comment>Urutan prioritas; dipakai pada KategoriEkonomi dan juga diturunkan ke Pendaftar (C-09)</rdfs:comment>
  </rdf:Property>
  <rdf:Property rdf:about="http://pintukuliah.local/ontologi#kode">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Kode unik instance referensi (P1, DOK-KIP, PED, ...)</rdfs:comment>
  </rdf:Property>
  <rdf:Property rdf:about="http://pintukuliah.local/ontologi#jenjang">
    <rdfs:domain rdf:resource="http://pintukuliah.local/ontologi#Pendaftar"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Property>
  <rdf:Property rdf:about="http://pintukuliah.local/ontologi#syarat_tahun_ok">
    <rdfs:domain rdf:resource="http://pintukuliah.local/ontologi#Pendaftar"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:comment>Lapis A</rdfs:comment>
  </rdf:Property>
  <rdf:Property rdf:about="http://pintukuliah.local/ontologi#per_bulan">
    <rdfs:domain rdf:resource="http://pintukuliah.local/ontologi#ZonaBiayaHidup"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Property>
  <rdf:Property rdf:about="http://pintukuliah.local/ontologi#kip_sma">
    <rdfs:domain rdf:resource="http://pintukuliah.local/ontologi#Pendaftar"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Property>
  <rdf:Property rdf:about="http://pintukuliah.local/ontologi#selisih_tahun">
    <rdfs:domain rdf:resource="http://pintukuliah.local/ontologi#Pendaftar"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:comment>Lapis A</rdfs:comment>
  </rdf:Property>
  <rdf:Property rdf:about="http://pintukuliah.local/ontologi#penerbit">
    <rdfs:domain rdf:resource="http://pintukuliah.local/ontologi#Sumber"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Property>
  <rdf:Property rdf:about="http://pintukuliah.local/ontologi#status_administrasi">
    <rdfs:domain rdf:resource="http://pintukuliah.local/ontologi#Pendaftar"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Lapis B</rdfs:comment>
  </rdf:Property>
  <rdf:Property rdf:about="http://pintukuliah.local/ontologi#tingkat_akreditasi">
    <rdfs:domain rdf:resource="http://pintukuliah.local/ontologi#Pendaftar"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:comment>Lapis A</rdfs:comment>
  </rdf:Property>
  <rdf:Property rdf:about="http://pintukuliah.local/ontologi#miskin_sktm">
    <rdfs:domain rdf:resource="http://pintukuliah.local/ontologi#Pendaftar"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:comment>Lapis A</rdfs:comment>
  </rdf:Property>
  <rdf:Property rdf:about="http://pintukuliah.local/ontologi#kks">
    <rdfs:domain rdf:resource="http://pintukuliah.local/ontologi#Pendaftar"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Property>
  <rdf:Property rdf:about="http://pintukuliah.local/ontologi#rentan_p3ke">
    <rdfs:domain rdf:resource="http://pintukuliah.local/ontologi#Pendaftar"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:comment>Lapis A</rdfs:comment>
  </rdf:Property>
  <rdf:Property rdf:about="http://pintukuliah.local/ontologi#prodi_terakreditasi">
    <rdfs:domain rdf:resource="http://pintukuliah.local/ontologi#Pendaftar"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:comment>Lapis A</rdfs:comment>
  </rdf:Property>
  <rdf:Property rdf:about="http://pintukuliah.local/ontologi#BERDASARKAN">
    <rdfs:domain rdf:resource="http://pintukuliah.local/ontologi#Rule"/>
    <rdfs:range rdf:resource="http://pintukuliah.local/ontologi#Sumber"/>
    <rdfs:comment>Regulasi yang menjadi dasar aturan. Di Neo4j relasi ini membawa properti bagian (halaman/pasal).</rdfs:comment>
  </rdf:Property>
  <rdf:Property rdf:about="http://pintukuliah.local/ontologi#kesimpulan">
    <rdfs:domain rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Statement"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Kesimpulan yang ditulis aturan saat menyala (MEMICU)</rdfs:comment>
  </rdf:Property>
  <rdf:Property rdf:about="http://pintukuliah.local/ontologi#pkh">
    <rdfs:domain rdf:resource="http://pintukuliah.local/ontologi#Pendaftar"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Property>
  <rdf:Property rdf:about="http://pintukuliah.local/ontologi#urutan">
    <rdfs:domain rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Statement"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
