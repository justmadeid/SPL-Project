    kip:lapis "C" ;
    kip:lapis_nama "Prioritas ekonomi" ;
    kip:maka "Memenuhi_Prioritas += 6" ;
    kip:nama "Prioritas 6: P3KE desil ≤ 3 di PTS" ;
    kip:strata 2 ;
    kip:urut 23 .

