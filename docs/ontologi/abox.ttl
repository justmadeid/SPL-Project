    kip:lapis_nama "Fakta pembantu" ;
    kip:maka "Prodi_Terakreditasi = False" ;
    kip:nama "Prodi belum terakreditasi" ;
    kip:strata 1 ;
    kip:urut 4 .

kip:Rule_C-06 a kip:Rule ;
    rdfs:label "Prioritas 6: P3KE desil ≤ 3 di PTS" ;
