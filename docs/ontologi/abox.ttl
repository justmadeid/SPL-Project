kip:Rule_A-04 a kip:Rule ;
    rdfs:label "Peringkat akreditasi tingkat 3" ;
    kip:BERDASARKAN kip:Sumber_PED ;
    kip:id "A-04" ;
    kip:jika "Akreditasi prodi ∈ {Baik / C}" ;
    kip:lapis "A" ;
    kip:lapis_nama "Fakta pembantu" ;
    kip:maka "Prodi terakreditasi, peringkat tingkat 3" ;
    kip:nama "Peringkat akreditasi tingkat 3" ;
    kip:strata 1 ;
    kip:urut 3 .

kip:Rule_A-05 a kip:Rule ;
    rdfs:label "Prodi belum terakreditasi" ;
