      <kip:Rule rdf:about="http://pintukuliah.local/ontologi#Rule_C-01">
        <rdfs:label>Prioritas 1: KIP SMA di PTN</rdfs:label>
        <kip:BERDASARKAN rdf:resource="http://pintukuliah.local/ontologi#Sumber_PED"/>
        <kip:MENYIMPULKAN rdf:resource="http://pintukuliah.local/ontologi#KategoriEkonomi_P1"/>
        <kip:id>C-01</kip:id>
        <kip:jika>Memiliki KIP SMA DAN kampus PTN</kip:jika>
        <kip:lapis>C</kip:lapis>
        <kip:lapis_nama>Prioritas ekonomi</kip:lapis_nama>
        <kip:maka>Memenuhi_Prioritas += 1</kip:maka>
        <kip:nama>Prioritas 1: KIP SMA di PTN</kip:nama>
        <kip:strata rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</kip:strata>
        <kip:urut rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">18</kip:urut>
