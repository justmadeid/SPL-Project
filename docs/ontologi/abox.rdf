    <kip:kesimpulan>Cocok dengan prioritas 1: Pemegang KIP SMA di PTN</kip:kesimpulan>
    <kip:urutan rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</kip:urutan>
